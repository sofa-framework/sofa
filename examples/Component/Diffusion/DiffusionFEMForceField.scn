<Node name="root" dt="0.001" gravity="0 0 0" >

    <Node name="plugins">

    </Node>

    <VisualStyle displayFlags="showVisualModels"/>
    <DefaultAnimationLoop computeBoundingBox="false" parallelODESolving="true"/>

    <Node name="direct_solver">
        <Node name="geometry">
            <RegularGridTopology name="grid" min="-1 -1 -1" max="1 1 1" n="10 10 10"/>
            <MechanicalObject template="Vec3" name="spatialState"/>

            <BoxROI name="leftFace"  box="-1.01 -1.01 -1.01  -0.99 1.01 1.01" drawBoxes="true"/>
            <BoxROI name="rightFace" box=" 0.99 -1.01 -1.01   1.01 1.01 1.01" drawBoxes="true"/>
            <BoxROI name="topFace"   box="-1.01 1.01 -1.01  1.01 0.99 1.01" drawBoxes="true"/>

            <Node name="tetrahedra">
                <TetrahedronSetTopologyContainer name="Tetra_topo"/>
                <TetrahedronSetTopologyModifier name="Modifier" />
                <TetrahedronSetGeometryAlgorithms template="Vec3" name="GeomAlgo" />
                <Hexa2TetraTopologicalMapping input="@../grid" output="@Tetra_topo" swapping="true"/>
            </Node>
        </Node>

        <Node name="diffusionHexas">
            <EulerImplicitIntegrationScheme name="timeIntegration" firstOrder="true" rayleighStiffness="0." rayleighMass="0." />
            <SparseLDLSolver template="CompressedRowSparseMatrix"/>

            <RegularGridTopology name="grid" min="0 0 0" max="0 1 1" n="10 10 10"/>
            <MechanicalObject template="Vec1" position="@grid.position" name="temperature" bbox="0 0 0 0 0 0"/>
            <MeshMatrixMass name="mass" template="Vec1,Vec3" massDensity="1" topology="@../geometry/grid" geometryState="@../geometry/spatialState"/>
            <DiffusionFEMForceField template="Vec1,Vec3,Hexahedron" name="diffusion" topology="@../geometry/grid"
                                    elementDiffusionCoefficient="1" spatialState="@../geometry/spatialState" mstate="@temperature"/>

            <LinearMovementProjectiveConstraint template="Vec1" indices="@../geometry/leftFace.indices"
                                                keyTimes="0 0.1 1e11" movements="0 100 100"/>
            <LinearMovementProjectiveConstraint template="Vec1" indices="@../geometry/topFace.indices"
                                                keyTimes="0 0.1 0.2 1e11" movements="0 20 60 60"/>
            <FixedProjectiveConstraint template="Vec1" indices="@../geometry/rightFace.indices"/>

            <!-- color palette: https://coolors.co/palette/f94144-f3722c-f8961e-f9844a-f9c74f-90be6d-43aa8b-4d908e-577590-277da1 -->
            <VisualMesh position="@../geometry/spatialState.position" elementSpace="0.2" lighting="true"
                        vertexValues="@temperature.position"
                        colorMap="#277DA1 #577590 #4D908E #43AA8B #90BE6D #F9C74F #F9844A #F8961E #F3722C #F94144"
                        colorMapRange="0 100"/>
        </Node>

        <Node name="diffusionTetras">
            <EulerImplicitIntegrationScheme name="timeIntegration" firstOrder="true" rayleighStiffness="0." rayleighMass="0." />
            <SparseLDLSolver template="CompressedRowSparseMatrix"/>

            <RegularGridTopology name="grid" min="0 0 0" max="0 1 1" n="10 10 10"/>
            <MechanicalObject template="Vec1" position="@grid.position" name="temperature" bbox="0 0 0 0 0 0"/>
            <MeshMatrixMass name="mass" template="Vec1,Vec3" massDensity="1" topology="@../geometry/tetrahedra/Tetra_topo" geometryState="@../geometry/spatialState"/>
            <DiffusionFEMForceField template="Vec1,Vec3,Tetrahedron" name="diffusion" topology="@../geometry/tetrahedra/Tetra_topo"
                                    elementDiffusionCoefficient="1" spatialState="@../geometry/spatialState" mstate="@temperature"/>


            <LinearMovementProjectiveConstraint template="Vec1" indices="@../geometry/leftFace.indices"
                                                keyTimes="0 0.1 1e11" movements="0 100 100"/>
            <LinearMovementProjectiveConstraint template="Vec1" indices="@../geometry/topFace.indices"
                                                keyTimes="0 0.1 0.2 1e11" movements="0 20 60 60"/>
            <FixedProjectiveConstraint template="Vec1" indices="@../geometry/rightFace.indices"/>

            <TransformEngine name="transform" input_position="@../geometry/spatialState.position" translation="3 0 0"/>
            <!-- color palette: https://coolors.co/palette/f94144-f3722c-f8961e-f9844a-f9c74f-90be6d-43aa8b-4d908e-577590-277da1 -->
            <VisualMesh position="@transform.output_position" topology="@../geometry/tetrahedra/Tetra_topo" elementSpace="0.2" lighting="true"
                        vertexValues="@temperature.position"
                        colorMap="#277DA1 #577590 #4D908E #43AA8B #90BE6D #F9C74F #F9844A #F8961E #F3722C #F94144"
                        colorMapRange="0 100"/>
        </Node>

    </Node>
</Node>
