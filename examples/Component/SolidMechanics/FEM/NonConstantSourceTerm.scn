<?xml version="1.0"?>
<!-- Compares a pressure/traction load applied two ways to an identical cantilever beam:

     PressureBeam:   SurfacePressureForceField
     SourceTermBeam: FEMSourceTermIntegrator with Traction
-->
<Node name="root" dt="1" gravity="0 0 0">
    <RequiredPlugin pluginName="Sofa.Component.AnimationLoop"/>
    <RequiredPlugin pluginName="Sofa.Component.Constraint.Projective"/>
    <RequiredPlugin pluginName="Sofa.Component.Engine.Select"/>
    <RequiredPlugin pluginName="Sofa.Component.LinearSolver.Direct"/>
    <RequiredPlugin pluginName="Sofa.Component.LinearSolver.Iterative"/>
    <RequiredPlugin pluginName="Sofa.Component.LinearSolver.Preconditioner"/>
    <RequiredPlugin pluginName="Sofa.Component.LinearSystem"/>
    <RequiredPlugin pluginName="Sofa.Component.Mass"/>
    <RequiredPlugin pluginName="Sofa.Component.MechanicalLoad"/>
    <RequiredPlugin pluginName="Sofa.Component.ODESolver.Backward"/>
    <RequiredPlugin pluginName="Sofa.Component.SolidMechanics.FEM.Elastic"/>
    <RequiredPlugin pluginName="Sofa.Component.StateContainer"/>
    <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Dynamic"/>
    <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Grid"/>
    <RequiredPlugin pluginName="Sofa.Component.Topology.Mapping"/>
    <RequiredPlugin pluginName="Sofa.Component.Visual"/>

    <DefaultAnimationLoop/>
    <VisualStyle displayFlags="showBehaviorModels showVisualModels showWireframe"/>

    <RegularGridTopology name="grid" n="27 9 9" min="0 0 0" max="2 0.4 0.4"/>

    <!-- Pressure applied via SurfacePressureForceField; red -->
    <Node name="PressureBeam">
        <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>

        <MatrixLinearSystem name="precondSystem" template="CompressedRowSparseMatrixd"/>
        <SSORPreconditioner name="precond" linearSystem="@precondSystem"/>

        <PreconditionedMatrixFreeSystem name="solverSystem" preconditionerSystem="@precondSystem"/>
        <PCGLinearSolver name="linear_solver" iterations="1000" tolerance="1e-8"
                         linearSystem="@solverSystem" preconditioner="@precond"/>

        <StaticSolver newtonSolver="@newton" linearSolver="@linear_solver"/>

        <MechanicalObject name="dofs" template="Vec3" src="@../grid" showObject="true" drawMode="1" showObjectScale="0.01" showColor="1 0 0 0.9"/>
        <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.45 0.45"/>
        <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

        <TetrahedronSetTopologyContainer name="Tetra_topo"/>
        <TetrahedronSetTopologyModifier name="TetraModifier"/>
        <TetrahedronSetGeometryAlgorithms name="TetraGeomAlgo" template="Vec3"/>
        <Hexa2TetraTopologicalMapping input="@../grid" output="@Tetra_topo" swapping="true"/>

        <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Tetrahedron" youngModulus="1e6" poissonRatio="0.3" topology="@Tetra_topo"/>

        <NodalMassDensity property="100"/>
        <FEMMass name="mass" template="Vec3,Tetrahedron" topology="@Tetra_topo"/>

        <Node name="Triangle">
            <TriangleSetTopologyContainer name="Triangle_topo"/>
            <TriangleSetTopologyModifier name="Modifier"/>
            <TriangleSetGeometryAlgorithms name="GeomAlgo" template="Vec3" drawTriangles="1" drawColorTriangles="1 0 0 1"/>
            <Tetra2TriangleTopologicalMapping input="@../Tetra_topo" output="@Triangle_topo"/>

            <BoxROI name="topFace" template="Vec3" box="-0.05 0.35 -0.05  2.05 0.45 0.45" drawBoxes="1"/>

            <Node name="TopFace">
                <TriangleSetTopologyContainer name="TopFace_topo" triangles="@../topFace.trianglesInROI"/>
                <TriangleSetTopologyModifier name="TopFaceModifier"/>
                <TriangleSetGeometryAlgorithms name="TopFaceGeomAlgo" template="Vec3"/>

                <SurfacePressureForceField name="pressure" template="Vec3" topology="@TopFace_topo" pressure="1000"/>
            </Node>
        </Node>
    </Node>

    <!-- Pressure applied via FEMSourceTermIntegrator; white -->
    <Node name="SourceTermBeam">
        <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>

        <MatrixLinearSystem name="precondSystem" template="CompressedRowSparseMatrixd"/>
        <SSORPreconditioner name="precond" linearSystem="@precondSystem"/>

        <PreconditionedMatrixFreeSystem name="solverSystem" preconditionerSystem="@precondSystem"/>
        <PCGLinearSolver name="linear_solver" iterations="1000" tolerance="1e-8"
                         linearSystem="@solverSystem" preconditioner="@precond"/>

        <StaticSolver newtonSolver="@newton" linearSolver="@linear_solver"/>

        <MechanicalObject name="dofs" template="Vec3" src="@../grid" showObject="true" drawMode="1" showObjectScale="0.01" showColor="1 1 1 1"/>
        <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.45 0.45"/>
        <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

        <TetrahedronSetTopologyContainer name="Tetra_topo"/>
        <TetrahedronSetTopologyModifier name="TetraModifier"/>
        <TetrahedronSetGeometryAlgorithms name="TetraGeomAlgo" template="Vec3"/>
        <Hexa2TetraTopologicalMapping input="@../grid" output="@Tetra_topo" swapping="true"/>

        <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Tetrahedron" youngModulus="1e6" poissonRatio="0.3" topology="@Tetra_topo"/>

        <NodalMassDensity property="100"/>
        <FEMMass name="mass" template="Vec3,Tetrahedron" topology="@Tetra_topo"/>

        <Node name="Triangle">
            <TriangleSetTopologyContainer name="Triangle_topo"/>
            <TriangleSetTopologyModifier name="Modifier"/>
            <TriangleSetGeometryAlgorithms name="GeomAlgo" template="Vec3" drawEdges="1" drawColorEdges="1 1 1 1"/>
            <Tetra2TriangleTopologicalMapping input="@../Tetra_topo" output="@Triangle_topo"/>

            <BoxROI name="topFace" template="Vec3" box="-0.05 0.35 -0.05  2.05 0.45 0.45"/>

            <Node name="TopFace">
                <TriangleSetTopologyContainer name="TopFace_topo" triangles="@../topFace.trianglesInROI"/>
                <TriangleSetTopologyModifier name="TopFaceModifier"/>
                <TriangleSetGeometryAlgorithms name="TopFaceGeomAlgo" template="Vec3"/>

                <TractionSourceTerm name="load" template="Vec3,Triangle" pressure="1000"/>

                <FEMSourceTermIntegrator name="traction" template="Vec3,Triangle" topology="@TopFace_topo"
                               quadratureDegree="1" nonConstantSources="@load"/>
            </Node>
        </Node>
    </Node>
</Node>
