<?xml version="1.0"?>
<!-- Demonstrates that VectorSourceTerm reproduces the existing dead loads of SOFA.

     Each case is a beam solved twice, once with an existing component and once with a
     NodalSourceDensity integrated by FEMSourceTermIntegrator. The two beams of a pair are
     independent and should coincide in the end.

     White:   VectorSourceTerm, in every pair
     Red:     FEMMass under gravity      (2D membrane, body force per unit area)
     Green:   QuadPressureForceField     (traction on the free end face)
     Yellow:  TrianglePressureForceField (the same traction, face triangulated)
     Magenta: EdgePressureForceField     (line load on the top edges of that face)

     The three traction cases are dead loads: their force is the prescribed traction times the
     area of the element surface at rest.

     The loaded elements are selected with a BoxROI. The existing components take the indices it
     returns and index the same topology the ROI read. FEMSourceTermIntegrator has no element
     selection and integrates a whole topology, so the source term is given a container built from
     the elements the ROI returns.
-->
<Node name="root" dt="1" gravity="0 -9.81 0">
    <Node name="RequiredPlugins">
        <RequiredPlugin pluginName="Sofa.Component.AnimationLoop"/>
        <RequiredPlugin pluginName="Sofa.Component.Constraint.Projective"/>
        <RequiredPlugin pluginName="Sofa.Component.Engine.Select"/>
        <RequiredPlugin pluginName="Sofa.Component.LinearSolver.Direct"/>
        <RequiredPlugin pluginName="Sofa.Component.Mass"/>
        <RequiredPlugin pluginName="Sofa.Component.MechanicalLoad"/>
        <RequiredPlugin pluginName="Sofa.Component.ODESolver.Backward"/>
        <RequiredPlugin pluginName="Sofa.Component.SolidMechanics.FEM.Elastic"/>
        <RequiredPlugin pluginName="Sofa.Component.StateContainer"/>
        <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Constant"/>
        <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Dynamic"/>
        <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Grid"/>
        <RequiredPlugin pluginName="Sofa.Component.Topology.Mapping"/>
        <RequiredPlugin pluginName="Sofa.Component.Visual"/>
        <RequiredPlugin pluginName="Sofa.GL.Component.Rendering2D"/>
    </Node>

    <DefaultAnimationLoop/>
    <VisualStyle displayFlags="showBehaviorModels showVisualModels"/>

    <Node name="Labels">
        <OglLabel label="VectorSourceTerm"           x="10" y="810" fontsize="16" color="1 1 1 1"/>
        <OglLabel label="FEMMass gravity"            x="10" y="832" fontsize="16" color="1 0 0 1"/>
        <OglLabel label="QuadPressureForceField"     x="10" y="854" fontsize="16" color="0 1 0 1"/>
        <OglLabel label="TrianglePressureForceField" x="10" y="876" fontsize="16" color="1 1 0 1"/>
        <OglLabel label="EdgePressureForceField"     x="10" y="898" fontsize="16" color="1 0 1 1"/>
    </Node>

    <!-- ==================== Body force: gravity through the mass; red ==================== -->
    <Node name="ReplicateGravity">
        <RegularGridTopology name="gridMembrane" n="13 3 1" min="0 0 0" max="4 0.5 0"/>

        <Node name="GravityViaMass">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec2" src="@../gridMembrane" showObject="true" drawMode="1" showObjectScale="0.05" showColor="1 0 0 0.5"/>
            <BoxROI name="boundary" template="Vec2" box="-0.05 -0.05 -0.05  0.05 0.55 0.05"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <TriangleSetTopologyContainer name="Triangle_topo"/>
            <TriangleSetTopologyModifier name="Modifier"/>
            <TriangleSetGeometryAlgorithms template="Vec2" name="GeomAlgo" drawTriangles="1" drawColorTriangles="1 0 0 0.5"/>
            <Quad2TriangleTopologicalMapping input="@../gridMembrane" output="@Triangle_topo" swapping="True"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec2,Triangle" youngModulus="1e6" poissonRatio="0.3" topology="@Triangle_topo"/>

            <NodalMassDensity property="100"/>
            <FEMMass name="mass" template="Vec2,Triangle" topology="@Triangle_topo"/>
        </Node>

        <Node name="GravityViaSourceTerm">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec2" src="@../gridMembrane" showObject="true" drawMode="1" showObjectScale="0.025" showColor="1 1 1 1"/>
            <BoxROI name="boundary" template="Vec2" box="-0.05 -0.05 -0.05  0.05 0.55 0.05"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <TriangleSetTopologyContainer name="Triangle_topo"/>
            <TriangleSetTopologyModifier name="Modifier"/>
            <TriangleSetGeometryAlgorithms template="Vec2" name="GeomAlgo" drawEdges="1" drawColorEdges="1 1 1 1"/>
            <Quad2TriangleTopologicalMapping input="@../gridMembrane" output="@Triangle_topo" swapping="True"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec2,Triangle" youngModulus="1e6" poissonRatio="0.3" topology="@Triangle_topo"/>

            <!-- Gravity needs to get zeroed for this Node, it will be enforced as a source term-->
            <Gravity gravity="0 0 0"/>
            <NodalMassDensity property="100"/>
            <FEMMass name="mass" template="Vec2,Triangle" topology="@Triangle_topo"/>

            <!-- density * gravity = 100 * (0, -9.81) -->
            <NodalSourceDensity name="bodyForceDensity" template="Vec2" property="0 -981"/>
            <VectorSourceTerm name="bodyForce" template="Vec2,Triangle" sourceDensity="@bodyForceDensity"/>

            <FEMSourceTermIntegrator name="source" template="Vec2,Triangle" topology="@Triangle_topo"
                           quadratureDegree="1" constantSources="@bodyForce"/>
        </Node>
    </Node>

    <!-- ============ Traction on the quads of the free end face; green ============ -->
    <Node name="ReplicateTractionQuads">
        <RegularGridTopology name="gridQuad" n="5 3 3" min="0 0 1" max="2 0.5 1.5"/>

        <Node name="QuadTractionViaPressureForceField">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec3" src="@../gridQuad" showObject="true" drawMode="1" showObjectScale="0.05" showColor="0 1 0 0.5"/>
            <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.55 4"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <HexahedronSetTopologyContainer name="Hexa_topo" src="@../gridQuad"/>
            <HexahedronSetGeometryAlgorithms template="Vec3" name="GeomAlgo" drawHexahedra="1" drawColorHexahedra="0 1 0 0.5"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Hexahedron"
                                            youngModulus="1000" poissonRatio="0.3" topology="@Hexa_topo"/>

            <BoxROI name="endFace" template="Vec3" quads="@Hexa_topo.quads"
                    box="1.95 -0.05 0.95  2.05 0.55 1.55"/>

            <QuadPressureForceField name="load" topology="@Hexa_topo"
                           quadList="@endFace.quadIndices" pressure="0 -1.5 0"/>
        </Node>

        <Node name="QuadTractionViaSourceTerm">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec3" src="@../gridQuad" showObject="true" drawMode="1" showObjectScale="0.025" showColor="1 1 1 1"/>
            <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.55 4"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <HexahedronSetTopologyContainer name="Hexa_topo" src="@../gridQuad"/>
            <HexahedronSetGeometryAlgorithms template="Vec3" name="GeomAlgo" drawEdges="1" drawColorEdges="1 1 1 1"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Hexahedron"
                                            youngModulus="1000" poissonRatio="0.3" topology="@Hexa_topo"/>

            <BoxROI name="endFace" template="Vec3" quads="@Hexa_topo.quads"
                    box="1.95 -0.05 0.95  2.05 0.55 1.55"/>

            <Node name="LoadedFace">
                <QuadSetTopologyContainer name="face" quads="@../endFace.quadsInROI"/>
                <NodalSourceDensity name="traction" template="Vec3" property="0 -1.5 0"/>
                <VectorSourceTerm name="load" template="Vec3,Quad" sourceDensity="@traction"/>
                <FEMSourceTermIntegrator name="source" template="Vec3,Quad" topology="@face"
                               quadratureDegree="1" constantSources="@load"/>
            </Node>
        </Node>
    </Node>

    <!-- ============ The same traction, face triangulated; yellow ============ -->
    <Node name="ReplicateTractionTriangles">
        <RegularGridTopology name="gridTriangle" n="5 3 3" min="0 0 2" max="2 0.5 2.5"/>

        <Node name="TriangleTractionViaPressureForceField">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec3" src="@../gridTriangle" showObject="true" drawMode="1" showObjectScale="0.05" showColor="1 1 0 0.5"/>
            <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.55 4"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <HexahedronSetTopologyContainer name="Hexa_topo" src="@../gridTriangle"/>
            <HexahedronSetGeometryAlgorithms template="Vec3" name="GeomAlgo" drawHexahedra="1" drawColorHexahedra="1 1 0 0.5"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Hexahedron"
                                            youngModulus="1000" poissonRatio="0.3" topology="@Hexa_topo"/>

            <Node name="Boundary">
                <QuadSetTopologyContainer name="quadSurface"/>
                <QuadSetTopologyModifier/>
                <Hexa2QuadTopologicalMapping input="@../Hexa_topo" output="@quadSurface"/>

                <Node name="Triangulated">
                    <TriangleSetTopologyContainer name="surface"/>
                    <TriangleSetTopologyModifier/>
                    <Quad2TriangleTopologicalMapping input="@../quadSurface" output="@surface"/>

                    <BoxROI name="endFace" template="Vec3" box="1.95 -0.05 1.95  2.05 0.55 2.55"/>

                    <TrianglePressureForceField name="load" topology="@surface"
                                   triangleList="@endFace.triangleIndices"
                                   useConstantForce="true" pressure="0 -1.5 0"/>
                </Node>
            </Node>
        </Node>

        <Node name="TriangleTractionViaSourceTerm">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec3" src="@../gridTriangle" showObject="true" drawMode="1" showObjectScale="0.025" showColor="1 1 1 1"/>
            <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.55 4"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <HexahedronSetTopologyContainer name="Hexa_topo" src="@../gridTriangle"/>
            <HexahedronSetGeometryAlgorithms template="Vec3" name="GeomAlgo" drawEdges="1" drawColorEdges="1 1 1 1"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Hexahedron"
                                            youngModulus="1000" poissonRatio="0.3" topology="@Hexa_topo"/>

            <Node name="Boundary">
                <QuadSetTopologyContainer name="quadSurface"/>
                <QuadSetTopologyModifier/>
                <Hexa2QuadTopologicalMapping input="@../Hexa_topo" output="@quadSurface"/>

                <Node name="Triangulated">
                    <TriangleSetTopologyContainer name="surface"/>
                    <TriangleSetTopologyModifier/>
                    <Quad2TriangleTopologicalMapping input="@../quadSurface" output="@surface"/>

                    <BoxROI name="endFace" template="Vec3" box="1.95 -0.05 1.95  2.05 0.55 2.55"/>

                    <Node name="LoadedFace">
                        <TriangleSetTopologyContainer name="face" triangles="@../endFace.trianglesInROI"/>
                        <NodalSourceDensity name="traction" template="Vec3" property="0 -1.5 0"/>
                        <VectorSourceTerm name="load" template="Vec3,Triangle" sourceDensity="@traction"/>
                        <FEMSourceTermIntegrator name="source" template="Vec3,Triangle" topology="@face"
                                       quadratureDegree="1" constantSources="@load"/>
                    </Node>
                </Node>
            </Node>
        </Node>
    </Node>

    <!-- ============ Line load on the top edges of the free end face; magenta ============ -->
    <Node name="ReplicateLoadOnEdges">
        <RegularGridTopology name="gridEdge" n="5 3 3" min="0 0 3" max="2 0.5 3.5"/>

        <Node name="EdgeTractionViaPressureForceField">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec3" src="@../gridEdge" showObject="true" drawMode="1" showObjectScale="0.05" showColor="1 0 1 0.5"/>
            <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.55 4"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <HexahedronSetTopologyContainer name="Hexa_topo" src="@../gridEdge"/>
            <HexahedronSetGeometryAlgorithms template="Vec3" name="GeomAlgo" drawHexahedra="1" drawColorHexahedra="1 0 1 0.5"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Hexahedron"
                                            youngModulus="1000" poissonRatio="0.3" topology="@Hexa_topo"/>

            <!-- the top row of the end face, x = 2 and z = 3.5 -->
            <BoxROI name="topEdges" template="Vec3" edges="@Hexa_topo.edges"
                    box="1.95 -0.05 3.45  2.05 0.55 3.55"/>

            <EdgePressureForceField name="load" topology="@Hexa_topo"
                           edgeIndices="@topEdges.edgeIndices" pressure="0 -0.8 0"/>
        </Node>

        <Node name="EdgeTractionViaSourceTerm">
            <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="1" absoluteResidualStoppingThreshold="1e-8"/>
            <StaticSolver newtonSolver="@newton"/>
            <SparseLDLSolver name="linear_solver" template="CompressedRowSparseMatrixd"/>

            <MechanicalObject name="dofs" template="Vec3" src="@../gridEdge" showObject="true" drawMode="1" showObjectScale="0.025" showColor="1 1 1 1"/>
            <BoxROI name="boundary" template="Vec3" box="-0.05 -0.05 -0.05  0.05 0.55 4"/>
            <FixedProjectiveConstraint name="dirichlet" indices="@boundary.indices"/>

            <HexahedronSetTopologyContainer name="Hexa_topo" src="@../gridEdge"/>
            <HexahedronSetGeometryAlgorithms template="Vec3" name="GeomAlgo" drawEdges="1" drawColorEdges="1 1 1 1"/>

            <LinearSmallStrainFEMForceField name="FEM" template="Vec3,Hexahedron"
                                            youngModulus="1000" poissonRatio="0.3" topology="@Hexa_topo"/>

            <!-- the top row of the end face, x = 2 and z = 3.5 -->
            <BoxROI name="topEdges" template="Vec3" edges="@Hexa_topo.edges"
                    box="1.95 -0.05 3.45  2.05 0.55 3.55"/>

            <Node name="LoadedEdges">
                <EdgeSetTopologyContainer name="line" edges="@../topEdges.edgesInROI"/>
                <NodalSourceDensity name="traction" template="Vec3" property="0 -0.8 0"/>
                <VectorSourceTerm name="load" template="Vec3,Edge" sourceDensity="@traction"/>
                <FEMSourceTermIntegrator name="source" template="Vec3,Edge" topology="@line"
                               quadratureDegree="1" constantSources="@load"/>
            </Node>
        </Node>
    </Node>
</Node>
